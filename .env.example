# ========= 必填（只需填这两项即可启动）=========
TG_TOKEN=
TG_CHAT_ID=

# ========= 常用可选（按需取消注释，不填则用智能默认值）=========
# Web 面板端口（Docker 默认 3000；Serv00 留空或设 DISABLE_WEB=1 仅用 TG 控制）
# PORT=3000
# DISABLE_WEB=0
# 对外开放 Web 面板时的访问口令（建议 16 位以上随机字符）
# DASHBOARD_TOKEN=

# GitHub Gist 云备份（可选，跨机器/重装自动恢复房间列表）
# GIST_TOKEN=
# GIST_ID=

# ========= 高级微调（系统已按 Docker / Serv00 自动适配，通常无需改动）=========
# TZ=Asia/Shanghai
# BIND_HOST=0.0.0.0
# DATABASE_PATH=./data/data.db
# FFMPEG_PATH=
# AUTO_DOWNLOAD_FFMPEG=1
# FFMPEG_DOWNLOAD_URL=
# FFMPEG_THREADS=0
# DOUYIN_COOKIE=
# MEM_ALERT_MB=0
# CRITICAL_MEM_MB=0
# DISK_ALERT_PCT=85