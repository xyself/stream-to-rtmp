# ========== Telegram ==========
# Bot Token（从 @BotFather 获取）
TG_TOKEN=

# 授权聊天 ID（必填，支持逗号分隔多个，私聊为正数，群组/频道为负数）
# 为空时程序将拒绝启动，避免机器人对所有人开放
# 示例：123456789 或 123456789,-100987654321
TG_CHAT_ID=

# ========== 数据库 ==========
DATABASE_PATH=./data/data.db

# ========== GitHub Gist 同步（可选） ==========
# 不填则跳过同步，数据仅存本地
# GIST_TOKEN: GitHub Personal Access Token（需要 gist scope）
# GIST_ID: Gist 的 ID（URL 中最后一段）
GIST_TOKEN=
GIST_ID=

# ========== Web 面板（可选） ==========
# 不填则不启动 Web 服务，填写端口号后启用面板和健康检查
# PORT=8080
# 面板监听地址，默认 127.0.0.1（仅本机）；需要对外访问时设为 0.0.0.0
# BIND_HOST=127.0.0.1
# 面板访问令牌，配置后访问面板与 /api/flow 需要 ?token=xxx
# DASHBOARD_TOKEN=

# ========== 低内存模式（512MB 级小内存主机建议开启） ==========
# 开启后：强制关闭视频转码（只用 copy），避免转码吃光内存
# LOW_MEMORY=1

# ========== FFmpeg（可选） ==========
# 不填则使用系统 PATH 中的 ffmpeg
# FFMPEG_PATH=/usr/bin/ffmpeg
